#
# Local config file
#
# -----------------------------------------------------------------------------

# Change it to your name.
MAINTAINER = $(shell whoami)

# use your own target directory
#TARGET_DIR = /path/to/your/root

# use your own sources directory
#SOURCE_DIR = /path/to/your/sources

# -----------------------------------------------------------------------------

# Choose one (1) of the following BOXMODELs. O n e !

# Coolstream
#BOXMODEL = nevis
#BOXMODEL = apollo
#BOXMODEL = shiner
#BOXMODEL = kronos
#BOXMODEL = kronos_v2

# AX/Mutant
#BOXMODEL = hd51
#BOXMODEL = hd60
#BOXMODEL = hd61

# WWIO
#BOXMODEL = bre2ze4k

# Air Digital
#BOXMODEL = h7

# AXAS
#BOXMODEL = e4hdultra

# Protek
#BOXMODEL = protek4k

# Maxytec
#BOXMODEL = multibox
#BOXMODEL = multiboxse

# VU+
#BOXMODEL = vusolo4k
#BOXMODEL = vuduo4k
#BOXMODEL = vuduo4kse
#BOXMODEL = vuultimo4k
#BOXMODEL = vuzero4k
#BOXMODEL = vuuno4k
#BOXMODEL = vuuno4kse
#BOXMODEL = vuduo

# -----------------------------------------------------------------------------

# Neutrino branch
#BS_PACKAGE_NEUTRINO_BRANCH = your/branch

# Neutrino uses PIP
#BS_PACKAGE_NEUTRINO_PIP = y

# Neutrino uses SoftCSA (software descrambling for CSA-ALT channels)
# requires OSCam; only for armbox/mipsbox, not coolstream
#BS_PACKAGE_NEUTRINO_SOFTCSA = y

# The four below default to n on a box short of flash, to y everywhere else

# Neutrino ships the Swagger UI docs page (~426 kB)
#BS_PACKAGE_NEUTRINO_API_DOC = y

# Neutrino ships the libraries a browser needs to play what the box sends
# (~177 kB); off, the player screen offers the stream to an outside player
#BS_PACKAGE_NEUTRINO_WEB_PLAYER = y

# Neutrino ships the handset photographs (28 to 134 kB)
# off, the remote control screen draws the keys instead
#BS_PACKAGE_NEUTRINO_HANDSET_PICTURES = y

# Neutrino lets AI clients reach the box over MCP with OAuth
# needs BS_PACKAGE_NEUTRINO_NI_WEB
#BS_PACKAGE_NEUTRINO_MCP = y

# Neutrino ships the new web interface (~9 kB)
# off, the pages and the server that answers them are both left out
#BS_PACKAGE_NEUTRINO_NI_WEB = y

# Neutrino API keys
#BS_PACKAGE_NEUTRINO_OMDB_API_KEY =
#BS_PACKAGE_NEUTRINO_TMDB_API_KEY =
#BS_PACKAGE_NEUTRINO_SHOUTCAST_DEV_ID =
#BS_PACKAGE_NEUTRINO_YOUTUBE_API_KEY =
#BS_PACKAGE_NEUTRINO_WEATHER_API_KEY =

# Neutrino configure options
#BS_PACKAGE_NEUTRINO_CONF_OPTS = --enable-care --disable-warranty

# -----------------------------------------------------------------------------

# Package configure options
#BS_PACKAGE_<PKG>_CONF_OPTS = --enable-care --disable-warranty

# -----------------------------------------------------------------------------

# use lastest VU+ drivers
#BS_PACKAGE_VUPLUS_DRIVERS_LATEST = y

# -----------------------------------------------------------------------------

# add own packages to image
#BS_PACKAGES_OWN = pkg01 pkg02

# -----------------------------------------------------------------------------

# Create debug-image. Not useful in real life.
#DEBUG = yes

# -----------------------------------------------------------------------------

# NI administrator mode. Do not touch!
#NI_ADMIN = true

# -----------------------------------------------------------------------------

# Github token to access our private repositories
#GITHUB_TOKEN = 
