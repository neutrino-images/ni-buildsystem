dashdec: honour Period@start for live SegmentTemplate@duration streams

Server-side stitched VOD-as-live streams use availabilityStartTime=1970
with a Period starting at the current wall-clock time and numbering
restarting at startNumber there. dashdec computed the segment number
from 1970, so every fragment 404ed.

--- a/libavformat/dashdec.c
+++ b/libavformat/dashdec.c
@@ -1442,6 +1442,19 @@ cleanup:
     return ret;
 }
 
+/* Seconds since the start of the (single) live Period on the wall clock.
+ * Server-side stitched streams (VOD-as-live, ad insertion) put the Period
+ * at a huge offset from availabilityStartTime=1970 and restart numbering
+ * at startNumber there; without this the segment number is computed from
+ * 1970 and every fragment request 404s. */
+static uint64_t live_period_elapsed(DASHContext *c, uint64_t delay)
+{
+    uint64_t now = get_current_time_in_sec();
+    uint64_t start = c->availability_start_time + c->period_start + delay;
+
+    return now > start ? now - start : 0;
+}
