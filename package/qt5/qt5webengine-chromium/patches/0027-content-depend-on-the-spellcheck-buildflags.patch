From: Claude Code <noreply@anthropic.com>
Subject: [PATCH] content: depend on the spellcheck buildflags

browser_context.h includes spellcheck_buildflags.h, but nothing in
content depends on the target that generates it, so a parallel build
can compile content/browser before the header exists.
---
--- a/chromium/content/browser/BUILD.gn
+++ b/chromium/content/browser/BUILD.gn
@@ -132,6 +132,7 @@
     "//base",
     "//base:base_static",
     "//base:clang_profiling_buildflags",
+    "//components/spellcheck:buildflags",
     "//base/third_party/dynamic_annotations",
     "//build:branding_buildflags",
     "//build:chromecast_buildflags",
--- a/chromium/content/public/browser/BUILD.gn
+++ b/chromium/content/public/browser/BUILD.gn
@@ -436,6 +436,7 @@
   public_deps = [
     "//build:chromecast_buildflags",
     "//components/download/public/common:public",
+    "//components/spellcheck:buildflags",
     "//components/services/storage/public/mojom",
     "//content/public/common:common_sources",
     "//device/vr/buildflags",
