diff --git a/js/hbbtv_nativevideo.js b/js/hbbtv_nativevideo.js
new file mode 100644
index 0000000..3bd8f1a
--- /dev/null
+++ b/js/hbbtv_nativevideo.js
@@ -0,0 +1,440 @@
+/*
+ * <video> playback on the hardware decoders of the receiver.
+ *
+ * Plain media URLs (mp4, HLS, DASH) set on a video element are not loaded by
+ * chromium but handed to the native player (QWebChannel object hbbtvPlayer);
+ * the element emulates the HTMLMediaElement state and events from its reports.
+ * The picture appears on the video plane below the transparent page.
+ * blob: sources (MediaSource players) stay with chromium.
+ */
+(function () {
+    if (window.__hbbtvNativeVideo)
+        return;
+    window.__hbbtvNativeVideo = true;
+    window.HBBTV_NATIVE_VIDEO = true;
+
+    var player = null;
+    var queue = [];
+    var active = null;
+
+    function log(msg) {
+        window.HBBTV_POLYFILL_DEBUG && console.log('hbbtv-native: ' + msg);
+    }
+
+    function call(fn, args) {
+        if (player)
+            player[fn].apply(player, args || []);
+        else
+            queue.push([fn, args]);
+    }
+
+    function connect() {
+        if (typeof QWebChannel === 'undefined' || !window.qt || !qt.webChannelTransport)
+            return setTimeout(connect, 50);
+        new QWebChannel(qt.webChannelTransport, function (channel) {
+            player = channel.objects.hbbtvPlayer;
+            player.stateChanged.connect(onState);
+            player.positionChanged.connect(onPosition);
+            queue.splice(0).forEach(function (c) { player[c[0]].apply(player, c[1] || []); });
+        });
+    }
+    connect();
+
+    if (window.MediaSource) {
+        var origAdd = MediaSource.prototype.addSourceBuffer;
+        MediaSource.prototype.addSourceBuffer = function (type) {
+            log('MediaSource.addSourceBuffer ' + type);
+            return origAdd.call(this, type);
+        };
+    }
+
+    var M = HTMLMediaElement.prototype;
+    var V = HTMLVideoElement.prototype;
+    var orig = {
+        play: M.play,
+        pause: M.pause,
+        load: M.load
+    };
+    ['src', 'currentTime', 'duration', 'paused', 'ended', 'readyState', 'networkState', 'playbackRate', 'error',
+     'videoWidth', 'videoHeight', 'buffered', 'seekable'].forEach(function (p) {
+        orig[p] = Object.getOwnPropertyDescriptor(M, p);
+    });
+
+    function state(el) {
+        if (!el.__native)
+            el.__native = { src: '', paused: true, ended: false, time: 0, duration: NaN, ready: 0, rate: 1, error: null, started: false, seeking: false };
+        return el.__native;
+    }
+
+    function absolute(url) {
+        try { return new URL(url, document.baseURI).href; } catch (e) { return url; }
+    }
+
+    function nativeUrl(url) {
+        return !!url && /^https?:/i.test(url);
+    }
+
+    function sourceOf(el) {
+        var s = state(el).src || el.getAttribute('src');
+        if (!s) {
+            var source = el.querySelector('source');
+            if (source)
+                s = source.getAttribute('src');
+        }
+        return s ? absolute(s) : '';
+    }
+
+    function managed(el) {
+        return nativeUrl(sourceOf(el));
+    }
+
+    function fire(el, type) {
+        el.dispatchEvent(new Event(type));
+    }
+
+    function reset(el) {
+        var s = state(el);
+        s.paused = true; s.ended = false; s.time = 0; s.duration = NaN;
+        s.ready = 0; s.error = null; s.started = false; s.seeking = false;
+    }
+
+    // the picture lies below the whole page: while it plays, nothing may
+    // paint over its place from below - the element and everything holding
+    // it, and whatever lies behind it, which a browser drawing the video
+    // itself would cover anyway. What lies in front of it stays.
+    var punched = [];
+    var punchedDepth = 0;
+    var punchCount = 0;
+    function depth(el) {
+        var n = 0;
+        for (var node = el; node; node = node.parentElement)
+            n++;
+        return n;
+    }
+    function setStyle(node, prop, value) {
+        if (!node.style)
+            return;
+        node.__punch = node.__punch || {};
+        if (node.__punch[prop])
+            return;
+        node.__punch[prop] = true;
+        punched.push([node, prop, node.style.getPropertyValue(prop), node.style.getPropertyPriority(prop)]);
+        node.style.setProperty(prop, value, 'important');
+    }
+    var punchedFull = false;
+    function fullscreen(el) {
+        var r = el.getBoundingClientRect();
+        return r.width >= window.innerWidth * 0.9 && r.height >= window.innerHeight * 0.9;
+    }
+    function punch(el) {
+        punchedDepth = depth(el);
+        punchedFull = fullscreen(el);
+        for (var node = el; node; node = node.parentElement)
+            setStyle(node, 'background', 'transparent');
+        var r = el.getBoundingClientRect();
+        if (r.width <= 0 || r.height <= 0)
+            return;
+        // elementsFromPoint skips elements without pointer events
+        var pe = [el.style.getPropertyValue('pointer-events'), el.style.getPropertyPriority('pointer-events')];
+        el.style.setProperty('pointer-events', 'auto', 'important');
+        [0.1, 0.5, 0.9].forEach(function (fx) {
+            [0.1, 0.5, 0.9].forEach(function (fy) {
+                var stack = document.elementsFromPoint(r.left + r.width * fx, r.top + r.height * fy);
+                var i = stack.indexOf(el);
+                if (i < 0)
+                    return;
+                var front = stack.slice(0, i);
+                stack.slice(i + 1).forEach(function (e) {
+                    if (e.contains(el))
+                        return;
+                    // covered by a full screen video: hidden, unless it holds
+                    // something shown in front of the video (then only
+                    // see-through); next to a video in a window - its button,
+                    // the tiles around it - only see-through
+                    if (!punchedFull || front.some(function (f) { return e.contains(f); }))
+                        setStyle(e, 'background', 'transparent');
+                    else
+                        setStyle(e, 'visibility', 'hidden');
+                });
+            });
+        });
+        if (pe[0])
+            el.style.setProperty('pointer-events', pe[0], pe[1]);
+        else
+            el.style.removeProperty('pointer-events');
+    }
+    // the polyfill sets src before it puts the element into the page, and
+    // applications rebuild theirs: punch again when the element moved and
+    // every few seconds
+    function repunch(el) {
+        if (fullscreen(el) !== punchedFull) {
+            unpunch();
+            punch(el);
+        } else if (depth(el) !== punchedDepth || ++punchCount % 4 === 0) {
+            punch(el);
+        }
+    }
+    function unpunch() {
+        punchedDepth = 0;
+        punched.splice(0).forEach(function (p) {
+            if (p[2])
+                p[0].style.setProperty(p[1], p[2], p[3]);
+            else
+                p[0].style.removeProperty(p[1]);
+            delete p[0].__punch;
+        });
+    }
+
+    function stopElement(el) {
+        if (active === el) {
+            unpunch();
+            log('stop ' + new Error().stack.split('\n').slice(2, 5).join(' | '));
+            active = null;
+            call('stop');
+        }
+        state(el).started = false;
+    }
+
+    function startElement(el) {
+        var s = state(el);
+        if (active && active !== el)
+            stopElement(active);
+        active = el;
+        unpunch();
+        punch(el);
+        s.paused = false;
+        s.ended = false;
+        s.started = true;
+        log('play ' + sourceOf(el));
+        fire(el, 'play');
+        call('play', [sourceOf(el), Math.round(s.time * 1000)]);
+        lastWindow = '';
+        updateWindow();
+    }
+
+    Object.defineProperty(V, 'src', {
+        configurable: true,
+        get: function () {
+            return state(this).src || orig.src.get.call(this);
+        },
+        set: function (value) {
+            var url = value ? absolute(String(value)) : '';
+            log('src = ' + url);
+            if (nativeUrl(url)) {
+                stopElement(this);
+                reset(this);
+                state(this).src = url;
+                fire(this, 'emptied');
+                if (this.autoplay)
+                    startElement(this);
+            } else {
+                if (value)
+                    log('chromium src = ' + String(value).substring(0, 80));
+                if (state(this).src)
+                    stopElement(this);
+                state(this).src = '';
+                orig.src.set.call(this, value);
+            }
+        }
+    });
+
+    V.play = function () {
+        if (!managed(this)) {
+            log('chromium play() ' + (this.currentSrc || this.getAttribute('src') || '(no src)'));
+            return orig.play.call(this);
+        }
+        log('play()');
+        var s = state(this);
+        if (active === this && s.started) {
+            if (s.paused) {
+                s.paused = false;
+                call('resume');
+                fire(this, 'play');
+            }
+        } else {
+            startElement(this);
+        }
+        return Promise.resolve();
+    };
+
+    V.pause = function () {
+        if (!managed(this))
+            return orig.pause.call(this);
+        log('pause()');
+        var s = state(this);
+        if (!s.paused) {
+            s.paused = true;
+            if (active === this)
+                call('pause');
+            fire(this, 'pause');
+        }
+    };
+
+    V.load = function () {
+        if (!managed(this))
+            return orig.load.call(this);
+        log('load()');
+        stopElement(this);
+        reset(this);
+        fire(this, 'emptied');
+        if (this.autoplay)
+            startElement(this);
+    };
+
+    Object.defineProperty(V, 'currentTime', {
+        configurable: true,
+        get: function () {
+            return managed(this) ? state(this).time : orig.currentTime.get.call(this);
+        },
+        set: function (value) {
+            if (!managed(this))
+                return orig.currentTime.set.call(this, value);
+            var s = state(this);
+            log('currentTime = ' + value);
+            s.time = Number(value) || 0;
+            if (active === this && s.started) {
+                s.seeking = true;
+                fire(this, 'seeking');
+                call('seek', [Math.round(s.time * 1000)]);
+            }
+        }
+    });
+
+    function readOnly(name, value) {
+        Object.defineProperty(V, name, {
+            configurable: true,
+            get: function () {
+                return managed(this) ? value(state(this)) : orig[name].get.call(this);
+            }
+        });
+    }
+    readOnly('duration', function (s) { return s.duration; });
+    readOnly('paused', function (s) { return s.paused; });
+    readOnly('ended', function (s) { return s.ended; });
+    readOnly('readyState', function (s) { return s.ready; });
+    readOnly('networkState', function (s) { return s.started ? 2 : 1; });
+    readOnly('error', function (s) { return s.error; });
+    // players look at these before they trust a stream; the decoder output is
+    // not known here, report an HD picture once playing
+    readOnly('videoWidth', function (s) { return s.ready ? 1280 : 0; });
+    readOnly('videoHeight', function (s) { return s.ready ? 720 : 0; });
+    function ranges(s) {
+        var end = isFinite(s.duration) ? s.duration : s.time;
+        var n = s.ready ? 1 : 0;
+        return {
+            length: n,
+            start: function (i) { if (i >= n) throw new DOMException('IndexSizeError'); return 0; },
+            end: function (i) { if (i >= n) throw new DOMException('IndexSizeError'); return end; }
+        };
+    }
+    readOnly('buffered', ranges);
+    readOnly('seekable', ranges);
+
+    Object.defineProperty(V, 'playbackRate', {
+        configurable: true,
+        get: function () {
+            return managed(this) ? state(this).rate : orig.playbackRate.get.call(this);
+        },
+        set: function (value) {
+            if (!managed(this))
+                return orig.playbackRate.set.call(this, value);
+            state(this).rate = Number(value);
+            fire(this, 'ratechange');
+        }
+    });
+
+    // the hardware picture follows the element on the page
+    var lastWindow = '';
+    function updateWindow() {
+        var el = active;
+        if (!el)
+            return;
+        var r = el.getBoundingClientRect();
+        var vw = window.innerWidth, vh = window.innerHeight;
+        var x = Math.max(0, Math.round(r.left)), y = Math.max(0, Math.round(r.top));
+        var w = Math.round(Math.min(r.right, vw)) - x, h = Math.round(Math.min(r.bottom, vh)) - y;
+        var key = [x, y, w, h, vw, vh].join(',');
+        if (key === lastWindow)
+            return;
+        lastWindow = key;
+        log('window ' + key);
+        call('setWindow', [x, y, w, h, vw, vh]);
+    }
+    window.addEventListener('resize', updateWindow);
+
+    function onState(name, info) {
+        var el = active;
+        if (!el)
+            return;
+        var s = state(el);
+        log('state ' + name + ' ' + info);
+        if (name === 'playing') {
+            if (s.ready < 4) {
+                s.ready = 4;
+                ['loadstart', 'loadedmetadata', 'loadeddata', 'canplay', 'canplaythrough'].forEach(function (t) { fire(el, t); });
+            }
+            s.paused = false;
+            repunch(el);
+            updateWindow();
+            fire(el, 'playing');
+        } else if (name === 'ended') {
+            active = null;
+            unpunch();
+            s.started = false;
+            s.paused = true;
+            s.ended = true;
+            fire(el, 'pause');
+            fire(el, 'ended');
+        } else if (name === 'error') {
+            active = null;
+            unpunch();
+            s.started = false;
+            s.paused = true;
+            s.error = { code: 4, message: info, MEDIA_ERR_SRC_NOT_SUPPORTED: 4 };
+            fire(el, 'error');
+        }
+    }
+
+    function onPosition(positionMs, durationMs) {
+        var el = active;
+        if (!el)
+            return;
+        var s = state(el);
+        s.time = positionMs / 1000;
+        var duration = durationMs > 0 ? durationMs / 1000 : Infinity;
+        if (duration !== s.duration) {
+            s.duration = duration;
+            fire(el, 'durationchange');
+        }
+        if (s.seeking) {
+            s.seeking = false;
+            fire(el, 'seeked');
+        }
+        fire(el, 'timeupdate');
+        repunch(el);
+        updateWindow();
+    }
+
+    // a removed element stops its playback
+    new MutationObserver(function (mutations) {
+        if (!active)
+            return;
+        mutations.forEach(function (m) {
+            m.removedNodes.forEach(function (node) {
+                if (active && (node === active || (node.contains && node.contains(active))))
+                    stopElement(active);
+            });
+        });
+    }).observe(document, { childList: true, subtree: true });
+
+    // the hardware picture lies below the page: keep video elements see-through
+    function transparentVideo() {
+        var style = document.createElement('style');
+        style.textContent = 'video { background: transparent !important; }';
+        (document.head || document.documentElement).appendChild(style);
+    }
+    if (document.readyState === 'loading')
+        document.addEventListener('DOMContentLoaded', transparentVideo);
+    else
+        transparentVideo();
+})();
