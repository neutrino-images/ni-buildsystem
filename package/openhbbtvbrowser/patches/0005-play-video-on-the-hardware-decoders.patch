diff --git a/nativeplayer.cpp b/nativeplayer.cpp
new file mode 100644
index 0000000..4a7c79e
--- /dev/null
+++ b/nativeplayer.cpp
@@ -0,0 +1,141 @@
+#include "nativeplayer.h"
+
+#include <QByteArray>
+#include <QDebug>
+#include <QUrl>
+
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <unistd.h>
+
+// neutrino's control API on this receiver; returns the body, or a null array
+static QByteArray controlApi(const QByteArray &query)
+{
+    QByteArray body;
+    int fd = socket(AF_INET, SOCK_STREAM, 0);
+    if (fd < 0)
+        return body;
+    struct timeval tv = { 5, 0 };
+    setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+    setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+    struct sockaddr_in addr = {};
+    addr.sin_family = AF_INET;
+    addr.sin_port = htons(80);
+    addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    if (::connect(fd, reinterpret_cast<struct sockaddr *>(&addr), sizeof(addr)) == 0) {
+        QByteArray request = "GET /control/zapto?" + query + " HTTP/1.0\r\nHost: 127.0.0.1\r\n\r\n";
+        if (::write(fd, request.constData(), request.size()) == request.size()) {
+            QByteArray response;
+            char buf[1024];
+            ssize_t n;
+            while ((n = ::read(fd, buf, sizeof(buf))) > 0)
+                response.append(buf, int(n));
+            int split = response.indexOf("\r\n\r\n");
+            if (response.contains(" 200 ") && split >= 0)
+                body = response.mid(split + 4).trimmed();
+        }
+    }
+    ::close(fd);
+    return body;
+}
+
+NativePlayer::NativePlayer(QObject *parent)
+    : QObject(parent)
+    , m_active(false)
+    , m_lastPosition(-1)
+{
+    m_timer.setInterval(500);
+    connect(&m_timer, &QTimer::timeout, this, &NativePlayer::poll);
+}
+
+NativePlayer::~NativePlayer()
+{
+    stop();
+}
+
+void NativePlayer::play(const QString &url, int startMs)
+{
+    stop();
+    qDebug() << "[native] play" << url << startMs;
+    QByteArray query = "hbbtvplay&url=" + QUrl::toPercentEncoding(url) + "&start=" + QByteArray::number(startMs);
+    if (controlApi(query).isNull()) {
+        Q_EMIT stateChanged(QStringLiteral("error"), QStringLiteral("player not available"));
+        return;
+    }
+    m_active = true;
+    m_state = QStringLiteral("starting");
+    m_lastPosition = -1;
+    m_timer.start();
+}
+
+void NativePlayer::poll()
+{
+    if (!m_active)
+        return;
+    const QList<QByteArray> status = controlApi("hbbtvstatus").split(' ');
+    if (status.size() < 3)
+        return;
+    const QString state = QString::fromLatin1(status.at(0));
+    const int position = status.at(1).toInt();
+    const int duration = status.at(2).toInt();
+
+    if (state == QLatin1String("ended") || state == QLatin1String("error") || state == QLatin1String("idle")) {
+        finish(state == QLatin1String("idle") ? QStringLiteral("ended") : state);
+        return;
+    }
+    if (state != m_state) {
+        m_state = state;
+        if (state == QLatin1String("playing") || state == QLatin1String("paused"))
+            Q_EMIT stateChanged(state, QString());
+    }
+    if (state != QLatin1String("starting") && position != m_lastPosition) {
+        m_lastPosition = position;
+        Q_EMIT positionChanged(position, duration);
+    }
+}
+
+void NativePlayer::pause()
+{
+    if (m_active)
+        controlApi("hbbtvpause");
+}
+
+void NativePlayer::resume()
+{
+    if (m_active)
+        controlApi("hbbtvresume");
+}
+
+void NativePlayer::seek(int positionMs)
+{
+    if (m_active)
+        controlApi("hbbtvseek&pos=" + QByteArray::number(positionMs));
+}
+
+void NativePlayer::setWindow(int x, int y, int width, int height, int pageWidth, int pageHeight)
+{
+    if (m_active)
+        controlApi("hbbtvwindow&x=" + QByteArray::number(x) + "&y=" + QByteArray::number(y)
+                   + "&w=" + QByteArray::number(width) + "&h=" + QByteArray::number(height)
+                   + "&pw=" + QByteArray::number(pageWidth) + "&ph=" + QByteArray::number(pageHeight));
+}
+
+void NativePlayer::stop()
+{
+    if (m_active)
+        finish(QStringLiteral("stopped"));
+}
+
+void NativePlayer::finish(const QString &state, const QString &info)
+{
+    m_timer.stop();
+    m_active = false;
+    m_state.clear();
+    // also after the end: neutrino gets live TV back with the stop
+    controlApi("hbbtvstop");
+    qDebug() << "[native]" << state << info;
+    Q_EMIT stateChanged(state, info);
+}
diff --git a/nativeplayer.h b/nativeplayer.h
new file mode 100644
index 0000000..ed8801d
--- /dev/null
+++ b/nativeplayer.h
@@ -0,0 +1,46 @@
+#ifndef NATIVEPLAYER_H
+#define NATIVEPLAYER_H
+
+#include <QObject>
+#include <QString>
+#include <QTimer>
+
+// plays <video> sources on the hardware decoders of the receiver instead of
+// decoding them in software in chromium: neutrino plays the stream (control
+// API zapto?hbbtv...), the picture appears on the video plane below the
+// transparent page. Not in this process: the GL driver of the receiver
+// crashes when one process draws with it and uses a decoder at once.
+class NativePlayer : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit NativePlayer(QObject *parent = nullptr);
+    ~NativePlayer();
+
+    Q_INVOKABLE void play(const QString &url, int startMs);
+    Q_INVOKABLE void pause();
+    Q_INVOKABLE void resume();
+    Q_INVOKABLE void seek(int positionMs);
+    Q_INVOKABLE void stop();
+    // where the page shows the video; the hardware picture follows it
+    Q_INVOKABLE void setWindow(int x, int y, int width, int height, int pageWidth, int pageHeight);
+
+Q_SIGNALS:
+    // "playing", "paused", "ended", "error", "stopped"
+    void stateChanged(const QString &state, const QString &info);
+    void positionChanged(int positionMs, int durationMs);
+
+private Q_SLOTS:
+    void poll();
+
+private:
+    void finish(const QString &state, const QString &info = QString());
+
+    QTimer m_timer;
+    bool m_active;
+    QString m_state;
+    int m_lastPosition;
+};
+
+#endif // NATIVEPLAYER_H
