+#if defined(HAVE_NATIVE_PLAYER)
+static void injectScript(QWebEnginePage *page, const QString &name, const QString &file)
+{
+    QFile f(file);
+    if (!f.open(QIODevice::ReadOnly)) {
+        qWarning() << "[native] script not found:" << file;
+        return;
+    }
+    QWebEngineScript script;
+    script.setName(name);
+    script.setSourceCode(QString::fromUtf8(f.readAll()));
+    script.setInjectionPoint(QWebEngineScript::DocumentCreation);
+    script.setRunsOnSubFrames(false);
+    script.setWorldId(QWebEngineScript::MainWorld);
+    page->scripts().insert(script);
+}
+
+// <video> on the hardware decoders, see nativeplayer.h
+void BrowserWindow::setupNativePlayer(QWebEnginePage *page)
+{
+    auto player = new NativePlayer(this);
+    auto channel = new QWebChannel(page);
+    channel->registerObject(QStringLiteral("hbbtvPlayer"), player);
+    page->setWebChannel(channel);
+    // before the polyfill, which builds its OIPF players on <video>
+    injectScript(page, QStringLiteral("qwebchannel"), QStringLiteral(":/qtwebchannel/qwebchannel.js"));
+    injectScript(page, QStringLiteral("hbbtv_nativevideo"), QStringLiteral(":/hbbtv_nativevideo.js"));
+    connect(page, &QWebEnginePage::loadStarted, player, &NativePlayer::stop);
+    connect(QCoreApplication::instance(), &QCoreApplication::aboutToQuit, player, &NativePlayer::stop);
+}
+#endif
