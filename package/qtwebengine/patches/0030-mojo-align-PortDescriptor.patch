From: Claude Code <noreply@anthropic.com>
Subject: [PATCH] mojo: align PortDescriptor

On armv7 the browser dies with SIGBUS in PortDescriptor::PortDescriptor()
called from Node::MergePorts(): the packed struct on the stack is not
8-byte aligned, but its constructor uses aligned NEON stores.
---
--- a/src/3rdparty/chromium/mojo/core/ports/event.h
+++ b/src/3rdparty/chromium/mojo/core/ports/event.h
@@ -66,7 +66,11 @@
   };
 
 #pragma pack(push, 1)
-  struct PortDescriptor {
+  // The struct is packed, but GCC still stores its Name members with
+  // 64-bit alignment hints (vst1.64 :64), which fault on ARM when an
+  // instance on the stack is not 8-byte aligned. Serialized descriptors
+  // are 8-byte aligned anyway (kPortsMessageAlignment).
+  struct alignas(8) PortDescriptor {
     PortDescriptor();
 
     NodeName peer_node_name;
