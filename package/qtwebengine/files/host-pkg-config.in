#!/bin/sh
#
# pkg-config for the host side of the chromium build (host tools linking
# against the host's nss, ...): the target pkg-config settings of the build
# environment must not leak into it.
#
exec env -u PKG_CONFIG_LIBDIR -u PKG_CONFIG_PATH -u PKG_CONFIG_SYSROOT_DIR /usr/bin/pkg-config "$@"
