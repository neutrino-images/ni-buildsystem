dashdec: skip unreadable subtitle representations instead of failing

A subtitle AdaptationSet that cannot be probed (e.g. a plain WebVTT
file while the webvtt demuxer is disabled) made avformat_open_input()
fail for the whole presentation. Drop such a representation with a
warning and keep the audio/video streams.

--- a/libavformat/dashdec.c
+++ b/libavformat/dashdec.c
@@ -2168,10 +2168,21 @@
         }
         ret = open_demux_for_component(s, rep);
 
-        if (ret)
+        /* An unreadable subtitle track (e.g. a plain .vtt file without a
+         * WebVTT demuxer) must not fail the whole presentation: drop it.
+         * On these failures no AVStream has been created yet. */
+        if (ret == AVERROR(ENOMEM) || ret == AVERROR_EXIT)
             return ret;
-        if (rep->ctx->nb_streams == 0)
-            return AVERROR_PATCHWELCOME;
+        if (ret < 0 || !rep->ctx || rep->ctx->nb_streams == 0) {
+            av_log(s, AV_LOG_WARNING, "Skipping unreadable subtitle representation '%s'\n",
+                   rep->id ? rep->id : "?");
+            free_representation(rep);
+            memmove(&c->subtitles[i], &c->subtitles[i + 1],
+                    (c->n_subtitles - i - 1) * sizeof(*c->subtitles));
+            c->n_subtitles--;
+            i--;
+            continue;
+        }
         rep->stream_index = stream_index;
         ++stream_index;
     }
