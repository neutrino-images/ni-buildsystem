From 382008b3f07d78e3abbc50d00bb857622dbbfac6 Mon Sep 17 00:00:00 2001
From: Denys Vlasenko <vda.linux@googlemail.com>
Date: Fri, 9 Oct 2026 16:37:30 +0200
Subject: [PATCH] tar: protect against Symlink+Hardlink attack

function                                             old     new   delta
create_links_from_list                                93     190     +97

Signed-off-by: Denys Vlasenko <vda.linux@googlemail.com>

Upstream: https://git.busybox.net/busybox/commit/?id=382008b3f07d78e3abbc50d00bb857622dbbfac6
---
 archival/libarchive/unsafe_symlink_target.c | 54 ++++++++++++++++++---
 1 file changed, 46 insertions(+), 8 deletions(-)

diff --git a/archival/libarchive/unsafe_symlink_target.c b/archival/libarchive/unsafe_symlink_target.c
index d764c89ab96a..65c782bdd44d 100644
--- a/archival/libarchive/unsafe_symlink_target.c
+++ b/archival/libarchive/unsafe_symlink_target.c
@@ -17,26 +17,64 @@ void FAST_FUNC create_or_remember_link(llist_t **link_placeholders,
 		return;
 	}
 	if (symlink(target, linkname) != 0) {
-		/* shared message */
+		// shared message
 		bb_perror_msg_and_die("can't create %slink '%s' to '%s'",
 			"sym", linkname, target
 		);
 	}
 }
 
+static int all_dir_components_are_dirs(char *path)
+{
+	struct stat sb;
+	char *slash;
+
+	slash = path;
+	while ((slash = strchr(slash, '/')) != NULL) {
+		int ok;
+		*slash = '\0';
+		ok = (lstat(path, &sb) == 0 && S_ISDIR(sb.st_mode));
+		*slash++ = '/';
+		if (!ok)
+			return 0;
+	}
+	return 1;
+}
+
 void FAST_FUNC create_links_from_list(llist_t *list)
 {
+	// This idea sounds better (fewer file ops):
+        //  Create hardlinks first, then symlinks.
+	// ^^^ but it breaks the "hardlink to symlink" case:
+	//  mkdir dir
+	//  >dir/a
+	//  ln -s ../dir/a dir/b
+	//  ln dir/b dir/c
+	//  mkdir new; tar cf - dir/a dir/b dir/c | tar -C new -xvf -
+	// On extract, 'c' will have no 'b' to be a hardlink to.
+
 	while (list) {
 		char *target;
+		char *linkname = list->data + 1;
 
-		target = list->data + 1 + strlen(list->data + 1) + 1;
-		if ((*list->data ? link : symlink) (target, list->data + 1)) {
-			/* shared message */
-			bb_error_msg_and_die("can't create %slink '%s' to '%s'",
-				*list->data ? "hard" : "sym",
-				list->data + 1, target
+		target = linkname + strlen(linkname) + 1;
+
+		// Check whether the linkname has suspicious components:
+		// SYMLINK_OUTSIDE_EXTRACT_DIR/etc/passwd sort of thing.
+		// (Our delayed creation of symlinks is not defending against it,
+		// we could create SYMLINK_OUTSIDE_EXTRACT_DIR ourself!)
+		if (!all_dir_components_are_dirs(linkname)) {
+			errno = ENOTDIR;
+			goto err;
+		}
+		if ((list->data[0] ? link : symlink) (target, linkname)) {
+			// shared message
+ err:
+			bb_perror_msg_and_die("can't create %slink '%s' to '%s'",
+				list->data[0] ? "hard" : "sym",
+				linkname, target
 			);
-			/* Note: GNU tar 1.34 errors out only _after_ all links are (attempted to be) created */
+			// Note: GNU tar 1.34 errors out only _after_ all links are (attempted to be) created
 		}
 		list = list->link;
 	}
