#!/bin/sh

. /etc/init.d/globals

# This script is called xupnpd as well, so "killall xupnpd" also ended the
# script itself, and "restart" never got to "start". Only end processes that
# run the xupnpd program: the shell running this script has busybox as exe.
xupnpd_kill()
{
	for pid in $(pidof xupnpd); do
		exe=$(readlink /proc/$pid/exe)
		[ "${exe##*/}" = "xupnpd" ] && kill $pid
	done
	return 0
}

case $1 in
	start)	
		if [ -e /var/etc/.xupnpd ]; then
			rm -rf /tmp/xupnpd-*
			rm -f /tmp/xupnpd.pid
			sleep 10 # FIXME; This is to workaround slow DHCP
			xupnpd &
		fi
	;;
	stop)
		if [ -e /var/etc/.xupnpd ]; then
			xupnpd_kill
		fi
	;;
	restart)
		if [ -e /var/etc/.xupnpd ]; then
			$0 stop
			$0 start
		fi
	;;
	*)
		echo "[$BASENAME] Usage: $0 {start|restart|stop}"
	;;
esac
